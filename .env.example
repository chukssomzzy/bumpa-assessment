# Postgres
DATABASE_URL=postgres://bumpa:bumpa@postgres:5432/bumpa

# Redis (BullMQ)
REDIS_URL=redis://redis:6379

# HMAC secret shared with the storefront producing purchase events
WEBHOOK_SECRET=dev-webhook-secret-change-me
# Max age of a signed request before it is rejected as stale (seconds)
WEBHOOK_TOLERANCE_SECONDS=300

# Payments: "fake" (in-memory) or "paystack"
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Cashback per badge, in kobo. 30000 kobo = NGN 300
CASHBACK_AMOUNT_KOBO=30000
PAYOUT_MAX_ATTEMPTS=5
# Re-dispatch payouts left pending longer than this (seconds)
PAYOUT_STALE_AFTER_SECONDS=300

PORT=3000
NODE_ENV=development

# --- Cloudflare tunnel (optional) -------------------------------------------
# Exposes the local api so Paystack can deliver transfer webhooks to a machine
# with no inbound route. Leave both unset to run the default stack.
#
# The token alone does NOT start the tunnel: those services sit behind
# `profiles: [tunnel]`, so the profile must be selected as well — either per
# command (`docker compose --profile tunnel up`) or persistently by uncommenting
# COMPOSE_PROFILES below, which Compose reads from this file automatically.
#
# In the Cloudflare tunnel's Public Hostname config, the service URL is
# `api:3000` — cloudflared runs inside the compose network, so `localhost` there
# would be the cloudflared container itself.
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
